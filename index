// Sorts transaction records (receiving/issuing/returns) so the most recent
// DATE always appears first, regardless of the order entries were typed in.
// Entries sharing the same date are ordered by entry id (most recently
// added first), so several items entered separately on one date still
// group together instead of scattering through the list.
function sortByDateThenEntryOrder(arr) {
    return [...arr].sort((a, b) => {
        const dateA = a.date || "";
        const dateB = b.date || "";
        if (dateA !== dateB) return dateA < dateB ? 1 : -1;
        return (b.id || 0) - (a.id || 0);
    });
}

