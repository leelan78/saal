<!DOCTYPE html>
<html lang="en"><head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pharmacy Inventory - With Search</title>
    
    <style>
        * {
            box-sizing: border-box;
        }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #1a3c5c, #2c5282);
            margin: 0;
            padding: 0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .login-container {
            background: white;
            border-radius: 16px;
            padding: 40px;
            width: 420px;
            max-width: 95%;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
        }
        .login-container .logo {
            text-align: center;
            margin-bottom: 30px;
        }
        .login-container .logo h1 {
            margin: 0;
            color: #1a3c5c;
            font-size: 24px;
        }
        .login-container .logo p {
            margin: 5px 0 0;
            color: #718096;
            font-size: 14px;
        }
        .login-container .logo .icon {
            font-size: 48px;
            display: block;
        }
        .form-group {
            margin-bottom: 20px;
        }
        .form-group label {
            display: block;
            font-weight: 600;
            color: #2d3748;
            margin-bottom: 5px;
            font-size: 14px;
        }
        .form-group input, .form-group select {
            width: 100%;
            padding: 12px 16px;
            border: 2px solid #e2e8f0;
            border-radius: 8px;
            font-size: 15px;
            transition: 0.2s;
            box-sizing: border-box;
            background: white;
        }
        .form-group input:focus, .form-group select:focus {
            outline: none;
            border-color: #2c5282;
            box-shadow: 0 0 0 3px rgba(44,82,130,0.1);
        }
        .form-group input.error {
            border-color: #c53030;
            box-shadow: 0 0 0 3px rgba(197,48,48,0.1);
        }
        .login-btn {
            width: 100%;
            padding: 14px;
            background: #2c5282;
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: 0.2s;
        }
        .login-btn:hover {
            background: #1a3c5c;
            transform: translateY(-1px);
        }
        .error-msg {
            color: #c53030;
            font-size: 14px;
            margin-top: 10px;
            text-align: center;
            display: none;
        }
        .error-msg.show {
            display: block;
        }
        .login-footer {
            text-align: center;
            margin-top: 20px;
            color: #718096;
            font-size: 13px;
        }
        .login-footer a {
            color: #2c5282;
            text-decoration: none;
            cursor: pointer;
        }
        .login-footer a:hover {
            text-decoration: underline;
        }

        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0,0,0,0.5);
            z-index: 9999;
            align-items: center;
            justify-content: center;
        }
        .modal.active {
            display: flex;
        }
        .modal-content {
            background: white;
            padding: 35px;
            border-radius: 16px;
            width: 520px;
            max-width: 95%;
            max-height: 90vh;
            overflow-y: auto;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
        }
        .modal-content h2 {
            margin: 0 0 5px;
            color: #1a3c5c;
        }
        .modal-content p.sub {
            color: #718096;
            margin: 0 0 20px;
            font-size: 14px;
        }
        .modal-actions {
            display: flex;
            gap: 10px;
            margin-top: 20px;
        }
        .modal-actions button {
            flex: 1;
            padding: 12px;
            border: none;
            border-radius: 8px;
            font-weight: 600;
            cursor: pointer;
            transition: 0.2s;
        }
        .modal-actions .btn-save {
            background: #2c5282;
            color: white;
        }
        .modal-actions .btn-save:hover {
            background: #1a3c5c;
        }
        .modal-actions .btn-cancel {
            background: #e2e8f0;
            color: #2d3748;
        }
        .modal-actions .btn-cancel:hover {
            background: #cbd5e0;
        }
        .modal-msg {
            margin-top: 10px;
            padding: 10px;
            border-radius: 8px;
            display: none;
            font-size: 14px;
        }
        .modal-msg.success {
            display: block;
            background: #c6f6d5;
            color: #22543d;
        }
        .modal-msg.error {
            display: block;
            background: #fed7d7;
            color: #9b2c2c;
        }

        #mainApp {
            display: none;
            width: 100%;
            min-height: 100vh;
            background: #eef2f7;
            padding: 20px;
        }
        .container {
            max-width: 1600px;
            margin: 0 auto;
            background: white;
            border-radius: 16px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
            overflow: hidden;
        }
        .header {
            background: linear-gradient(135deg, #1a3c5c, #2c5282);
            color: white;
            padding: 20px 25px;
        }
        .header h1 {
            margin: 0;
            font-size: 1.8rem;
        }
        .header p {
            margin: 5px 0 0;
            opacity: 0.8;
        }
        .tab {
            display: flex;
            background: #f8f9fa;
            border-bottom: 1px solid #dee2e6;
            flex-wrap: wrap;
        }
        .tab button {
            background: none;
            border: none;
            padding: 14px 24px;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            transition: 0.2s;
            color: #495057;
        }
        .tab button:hover {
            background: #e9ecef;
            color: #1a3c5c;
        }
        .tab button.active {
            background: white;
            color: #2c5282;
            border-bottom: 3px solid #2c5282;
        }
        .tab button.setup-tab {
            color: #d69e2e;
        }
        .tab button.setup-tab:hover {
            background: #fffbeb;
            color: #b7791f;
        }
        .tab button.setup-tab.active {
            color: #b7791f;
            border-bottom-color: #d69e2e;
            background: #fffbeb;
        }
        .tabcontent {
            display: none;
            padding: 25px;
            animation: fadeIn 0.3s;
        }
        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }
        .form-card {
            background: #f8f9fa;
            border-radius: 12px;
            padding: 20px;
            margin-bottom: 30px;
            border: 1px solid #e2e8f0;
        }
        .form-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 15px;
        }
        .form-group {
            display: flex;
            flex-direction: column;
        }
        .form-group label {
            font-weight: 600;
            margin-bottom: 5px;
            color: #2d3748;
            font-size: 13px;
        }
        .form-group input, .form-group select {
            padding: 10px 12px;
            border: 1px solid #cbd5e0;
            border-radius: 8px;
            font-size: 14px;
            transition: 0.2s;
            box-sizing: border-box;
            background: white;
        }
        .form-group input:focus, .form-group select:focus {
            outline: none;
            border-color: #2c5282;
            box-shadow: 0 0 0 3px rgba(44,82,130,0.1);
        }
        /* Allow typing in select (datalist style) */
        .form-group input[list] {
            background: white;
        }
        .form-group select {
            cursor: pointer;
        }
        button {
            background: #2c5282;
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 8px;
            cursor: pointer;
            font-weight: 600;
            font-size: 14px;
            transition: 0.2s;
        }
        button:hover {
            background: #1a3c5c;
            transform: translateY(-1px);
        }
        button:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }
        .btn-success {
            background: #2b6e3c;
        }
        .btn-success:hover {
            background: #1e4d2a;
        }
        .btn-warning {
            background: #d69e2e;
        }
        .btn-warning:hover {
            background: #b7791f;
        }
        .btn-outline {
            background: white;
            color: #2c5282;
            border: 1px solid #2c5282;
        }
        .btn-outline:hover {
            background: #2c5282;
            color: white;
        }
        .btn-danger {
            background: #c53030;
        }
        .btn-danger:hover {
            background: #9b2c2c;
        }
        .btn-clear-all {
            background: #c53030;
            color: white;
        }
        .btn-clear-all:hover {
            background: #9b2c2c;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 13px;
        }
        .table-wrapper {
            overflow-x: auto;
            border-radius: 10px;
            border: 1px solid #e2e8f0;
            max-height: 500px;
            overflow-y: auto;
        }
        th, td {
            border: 1px solid #e2e8f0;
            padding: 10px 8px;
            text-align: left;
        }
        th {
            background: #2c5282;
            color: white;
            font-weight: 600;
            position: sticky;
            top: 0;
            z-index: 10;
            cursor: pointer;
            user-select: none;
        }
        th:hover {
            background: #1a3c5c;
        }
        tr:nth-child(even) {
            background: #f8f9fa;
        }
        .search-section {
            background: #f0f4f8;
            border-radius: 12px;
            padding: 20px;
            margin-bottom: 25px;
        }
        .result-count {
            margin: 15px 0 10px;
            padding: 10px;
            background: #e9ecef;
            border-radius: 8px;
            font-weight: 600;
        }
        .field-hint {
            display: block;
            margin-top: 6px;
            font-size: 12px;
            font-weight: 600;
            color: #2c5282;
        }
        .field-hint.warning {
            color: #c53030;
        }
        .list-manager-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 16px;
            margin-top: 10px;
        }
        .list-manager-col h4 {
            margin: 0 0 8px;
            color: #1a3c5c;
        }
        .list-manager-add {
            display: flex;
            gap: 6px;
            margin-bottom: 10px;
        }
        .list-manager-add input {
            flex: 1;
            padding: 8px 10px;
            border: 2px solid #e2e8f0;
            border-radius: 6px;
            font-size: 13px;
            min-width: 0;
        }
        .list-manager-add button {
            padding: 8px 12px;
            font-size: 13px;
        }
        .managed-list {
            max-height: 220px;
            overflow-y: auto;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            padding: 6px;
        }
        .managed-list-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 6px 8px;
            font-size: 13px;
            border-bottom: 1px solid #f0f0f0;
        }
        .managed-list-item:last-child {
            border-bottom: none;
        }
        .managed-list-item .btn-delete-sm {
            background: none;
            border: none;
            cursor: pointer;
            font-size: 13px;
            padding: 2px 6px;
        }
        .managed-list-empty {
            padding: 10px;
            color: #a0aec0;
            font-size: 13px;
            font-style: italic;
        }
        @media (max-width: 900px) {
            .list-manager-grid { grid-template-columns: 1fr 1fr; }
        }
        @media (max-width: 480px) {
            .list-manager-grid { grid-template-columns: 1fr; }
        }
        .pending-qty-input {
            width: 80px;
            padding: 6px 8px;
            border: 2px solid #e2e8f0;
            border-radius: 6px;
            font-size: 14px;
        }
        .pending-qty-input:focus {
            outline: none;
            border-color: #2c5282;
        }
        .pending-text-input, .pending-date-input {
            width: 100%;
            min-width: 110px;
            padding: 6px 8px;
            border: 2px solid #e2e8f0;
            border-radius: 6px;
            font-size: 14px;
            box-sizing: border-box;
        }
        .pending-text-input:focus, .pending-date-input:focus {
            outline: none;
            border-color: #2c5282;
        }
        .badge {
            display: inline-block;
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 600;
        }
        .badge-reorder {
            background: #c53030;
            color: white;
        }
        .badge-outofstock {
            background: #1a1a1a;
            color: white;
        }
        .badge-ok {
            background: #2b6e3c;
            color: white;
        }
        .badge-expired {
            background: #742a2a;
            color: white;
        }
        .badge-expiring-soon {
            background: #d69e2e;
            color: white;
        }
        .badge-good {
            background: #2b6e3c;
            color: white;
        }
        .expired-row {
            background: #fed7d7 !important;
        }
        .expiring-soon-row {
            background: #feebc8 !important;
        }
        .flex-btns {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            margin-bottom: 15px;
        }
        .stats-grid {
            display: flex;
            gap: 20px;
            flex-wrap: wrap;
            margin-bottom: 20px;
        }
        .stat-card {
            background: white;
            padding: 15px 25px;
            border-radius: 12px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.05);
            flex: 1;
            min-width: 150px;
            text-align: center;
            border: 1px solid #e2e8f0;
        }
        .stat-card h4 {
            margin: 0 0 5px;
            color: #4a5568;
            font-size: 13px;
        }
        .stat-card .number {
            font-size: 28px;
            font-weight: bold;
            color: #2c5282;
        }
        .sort-indicator {
            font-size: 10px;
            margin-left: 5px;
        }
        .empty-state {
            text-align: center;
            padding: 40px;
            color: #718096;
            font-size: 16px;
        }
        .empty-state .icon {
            font-size: 48px;
            display: block;
            margin-bottom: 10px;
        }
        .manual-entry-note {
            background: #ebf8ff;
            border-left: 4px solid #2c5282;
            padding: 12px 16px;
            border-radius: 8px;
            margin-bottom: 15px;
        }
        .manual-entry-note strong {
            color: #2c5282;
        }
        .setup-item {
            background: #f8f9fa;
            border: 1px solid #e2e8f0;
            border-radius: 10px;
            padding: 15px;
            margin-bottom: 12px;
            transition: 0.2s;
        }
        .setup-item:hover {
            border-color: #2c5282;
            box-shadow: 0 2px 8px rgba(44,82,130,0.1);
        }
        .setup-item .item-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 10px;
            flex-wrap: wrap;
            gap: 8px;
        }
        .setup-item .item-header .item-id {
            font-weight: 600;
            color: #2c5282;
            font-size: 13px;
        }
        .setup-item .item-header .item-actions {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }
        .setup-item .item-header button {
            padding: 4px 12px;
            font-size: 12px;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            transition: 0.2s;
        }
        .setup-item .item-header .btn-edit {
            background: #2c5282;
            color: white;
        }
        .setup-item .item-header .btn-edit:hover {
            background: #1a3c5c;
        }
        .setup-item .item-header .btn-delete {
            background: #c53030;
            color: white;
        }
        .setup-item .item-header .btn-delete:hover {
            background: #9b2c2c;
        }
        .setup-item .item-fields {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 10px;
            margin-top: 8px;
        }
        .setup-item .item-fields .field-group {
            display: flex;
            flex-direction: column;
        }
        .setup-item .item-fields .field-group label {
            font-size: 11px;
            font-weight: 600;
            color: #4a5568;
            margin-bottom: 3px;
        }
        .setup-item .item-fields .field-group input, 
        .setup-item .item-fields .field-group select {
            padding: 6px 10px;
            border: 1px solid #cbd5e0;
            border-radius: 6px;
            font-size: 13px;
            transition: 0.2s;
            background: white;
        }
        .setup-item .item-fields .field-group input:focus,
        .setup-item .item-fields .field-group select:focus {
            outline: none;
            border-color: #2c5282;
            box-shadow: 0 0 0 3px rgba(44,82,130,0.1);
        }
        .setup-item .item-fields .field-group input.editing,
        .setup-item .item-fields .field-group select.editing {
            border-color: #2c5282;
            background: #ebf8ff;
        }
        .setup-item .item-edit-actions {
            margin-top: 10px;
            display: flex;
            gap: 8px;
            justify-content: flex-end;
        }
        .setup-item .item-edit-actions button {
            padding: 6px 16px;
            font-size: 13px;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            transition: 0.2s;
        }
        .setup-item .item-edit-actions .btn-save-edit {
            background: #2b6e3c;
            color: white;
        }
        .setup-item .item-edit-actions .btn-save-edit:hover {
            background: #1e4d2a;
        }
        .setup-item .item-edit-actions .btn-cancel-edit {
            background: #e2e8f0;
            color: #2d3748;
        }
        .setup-item .item-edit-actions .btn-cancel-edit:hover {
            background: #cbd5e0;
        }
        .setup-search {
            margin-bottom: 20px;
        }
        .setup-search input {
            width: 100%;
            padding: 10px 16px;
            border: 2px solid #e2e8f0;
            border-radius: 8px;
            font-size: 14px;
        }
        .setup-search input:focus {
            outline: none;
            border-color: #2c5282;
        }
        .setup-stats {
            display: flex;
            gap: 15px;
            margin-bottom: 20px;
            flex-wrap: wrap;
        }
        .setup-stats .stat-badge {
            background: #f0f4f8;
            padding: 8px 16px;
            border-radius: 20px;
            font-size: 13px;
        }
        .setup-stats .stat-badge strong {
            color: #2c5282;
        }
        .no-items-msg {
            text-align: center;
            padding: 30px;
            color: #718096;
        }
        /* Search box styles */
        .search-box {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            align-items: center;
        }
        .search-box input {
            flex: 1;
            min-width: 200px;
            padding: 10px 16px;
            border: 2px solid #e2e8f0;
            border-radius: 8px;
            font-size: 14px;
            transition: 0.2s;
        }
        .search-box input:focus {
            outline: none;
            border-color: #2c5282;
            box-shadow: 0 0 0 3px rgba(44,82,130,0.1);
        }
        .search-box .result-count {
            font-size: 14px;
            color: #4a5568;
            font-weight: 600;
            padding: 8px 12px;
            background: #e9ecef;
            border-radius: 8px;
            min-width: 100px;
            text-align: center;
        }
        @media (max-width: 768px) {
            .tab button { padding: 10px 16px; font-size: 13px; }
            .form-grid { grid-template-columns: 1fr; }
            .header { flex-direction: column; gap: 10px; }
            .setup-item .item-fields {
                grid-template-columns: 1fr 1fr;
            }
            .modal-content {
                padding: 20px;
                width: 98%;
            }
            .search-box input {
                min-width: 150px;
            }
        }
        @media (max-width: 480px) {
            .setup-item .item-fields {
                grid-template-columns: 1fr;
            }
            .search-box {
                flex-direction: column;
            }
            .search-box input {
                width: 100%;
            }
        }
    </style>

    <!-- Firebase (real-time shared database) -->
    <script src="https://www.gstatic.com/firebasejs/10.13.0/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.13.0/firebase-firestore-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.13.0/firebase-auth-compat.js"></script>
</head>
<body>

<!-- SESSION CHECK SPLASH: shown by default on every load/refresh while Firebase
     figures out if you're already logged in, so the login form never flashes
     for someone who's already signed in. -->
<div id="sessionCheck" style="display:flex; min-height:100vh; align-items:center; justify-content:center;">
    <div style="width:36px; height:36px; border:3px solid rgba(255,255,255,0.3); border-top-color:#fff; border-radius:50%; animation:spin 0.8s linear infinite;"></div>
</div>
<style>@keyframes spin { to { transform: rotate(360deg); } }</style>

<!-- LOGIN FORM -->
<div class="login-container" id="loginForm" style="display: none;">
    <div class="logo">
        <span class="icon">🏥</span>
        <h1>Pharmacy Inventory</h1>
        <p>With Search &amp; Location Dropdown</p>
    </div>
    <div class="form-group">
        <label>👤 Email</label>
        <input type="email" id="username" placeholder="Enter your team email">
    </div>
    <div class="form-group">
        <label>🔒 Password</label>
        <input type="password" id="password" placeholder="Enter password" onkeydown="if(event.key==='Enter') login()">
    </div>
    <button class="login-btn" onclick="login()">🔓 Login</button>
    <div class="error-msg" id="loginError">❌ Invalid email or password!</div>
    <div class="login-footer">
        <a onclick="forgotPassword()">🔑 Forgot Password?</a>
    </div>
</div>

<!-- CHANGE PASSWORD MODAL -->
<div class="modal" id="passwordModal" style="display: none;">
    <div class="modal-content">
        <h2>🔑 Change Password</h2>
        <p class="sub">Update your login password for security</p>
