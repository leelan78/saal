function sortInventory(key) {
    if(sortConfig.key === key) {
        sortConfig.direction = sortConfig.direction === 'asc' ? 'desc' : 'asc';
    } else {
        sortConfig.key = key;
        sortConfig.direction = 'asc';
    }
    
    inventoryData.sort((a, b) => {
        let valA = a[key] || "";
        let valB = b[key] || "";
        if(typeof valA === 'string') valA = valA.toLowerCase();
        if(typeof valB === 'string') valB = valB.toLowerCase();
        if(valA < valB) return sortConfig.direction === 'asc' ? -1 : 1;
        if(valA > valB) return sortConfig.direction === 'asc' ? 1 : -1;
        return 0;
    });
    
    refreshInventory();
    document.querySelectorAll('#inventoryTable th .sort-indicator').forEach(el => el.textContent = '↕');
    const ths = document.querySelectorAll('#inventoryTable th');
    const indexMap = { id: 0, name: 1, location: 2, balance: 7, expiryDate: 10 };
    if(indexMap[key] !== undefined) {
        const th = ths[indexMap[key]];
        if(th) {
            const indicator = th.querySelector('.sort-indicator');
            if(indicator) indicator.textContent = sortConfig.direction === 'asc' ? '↑' : '↓';
        }
    }
}

