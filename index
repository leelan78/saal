}

function renderRequisitions() {
    const historyLabel = document.getElementById("requisitionsHistoryLabel");
    const historyBody = document.getElementById("requisitionsBody");
    const approvalsCard = document.getElementById("pendingApprovalsCard");
    const approvalsBody = document.getElementById("pendingApprovalsBody");
    const approvalsCount = document.getElementById("pendingApprovalsCount");
    if (!historyBody) return; // Requisitions tab not in DOM yet

    const isAdmin = currentUserRole === "admin";
    if (historyLabel) historyLabel.textContent = isAdmin ? "All Requests" : "My Requests";

    const badge = document.getElementById("requisitionsBadge");
    if (badge) {
        const pendingCount = isAdmin ? requisitions.filter(r => r.status === "pending").length : 0;
        badge.textContent = pendingCount;
        badge.style.display = pendingCount > 0 ? "inline-block" : "none";
    }

    // --- Pending Approvals (admin only) ---
    if (approvalsCard) approvalsCard.style.display = isAdmin ? "block" : "none";
    if (isAdmin && approvalsBody) {
        const pending = requisitions.filter(r => r.status === "pending");
        if (approvalsCount) approvalsCount.textContent = pending.length;

        // If a new request comes in from another device while the admin is mid-review,
        // a fresh render must NOT wipe out a qty they've already started typing for an
        // existing row. Capture whatever is currently in each qty box first, and restore
        // it after rebuilding the table (unless that request is no longer pending).
        const inProgressQty = {};
        for (const r of pending) {
            const existingInput = document.getElementById("approveQty_" + r.id);
            if (existingInput && document.activeElement !== existingInput) {
                // Only remember it if the admin isn't actively typing in it right now -
                // if they ARE actively in it, leave that box alone entirely (see below).
                inProgressQty[r.id] = existingInput.value;
            }
        }
        const activeInput = document.activeElement && document.activeElement.id && document.activeElement.id.startsWith("approveQty_")
            ? document.activeElement : null;
        const activeReqId = activeInput ? activeInput.id.replace("approveQty_", "") : null;
        const activeValue = activeInput ? activeInput.value : null;
        const activeSelectionStart = activeInput ? activeInput.selectionStart : null;
        const activeSelectionEnd = activeInput ? activeInput.selectionEnd : null;

        approvalsBody.innerHTML = "";
        for (const r of pending) {
            const row = approvalsBody.insertRow();
            row.insertCell(0).textContent = r.date || "";
            row.insertCell(1).textContent = r.drug || "";
            row.insertCell(2).textContent = r.location || "";
            row.insertCell(3).textContent = r.qtyRequested || 0;

            const stockItem = inventoryData.find(i => i.name.toLowerCase() === (r.drug || "").toLowerCase());
            const availCell = row.insertCell(4);
            if (stockItem) {
                availCell.textContent = `${stockItem.balance} ${stockItem.unit || ""}`.trim();
                if (stockItem.balance < r.qtyRequested) {
                    availCell.style.color = "#c53030";
                    availCell.style.fontWeight = "600";
                    availCell.title = "Not enough stock to fully cover this request";
                }
            } else {
                availCell.textContent = "Not in inventory";
                availCell.style.color = "#c53030";
            }

            const qtyCell = row.insertCell(5);
            const qtyInput = document.createElement("input");
            qtyInput.type = "number";
            qtyInput.min = "1";
            qtyInput.className = "pending-qty-input";
            qtyInput.id = "approveQty_" + r.id;
            if (r.id === activeReqId) {
                qtyInput.value = activeValue;
            } else if (Object.prototype.hasOwnProperty.call(inProgressQty, r.id)) {
                qtyInput.value = inProgressQty[r.id];
            } else {
                qtyInput.value = r.qtyApproved != null ? r.qtyApproved : r.qtyRequested;
            }
            if (stockItem) qtyInput.title = `Available: ${stockItem.balance} ${stockItem.unit || ""}`;
            qtyCell.appendChild(qtyInput);

            row.insertCell(6).textContent = r.unit || "";
            row.insertCell(7).textContent = r.requestedBy || "";
            row.insertCell(8).textContent = r.notes || "";

            const actionCell = row.insertCell(9);
            const approveBtn = document.createElement("button");
            approveBtn.className = "btn-success";
            approveBtn.textContent = "✅ Approve";
            approveBtn.style.marginRight = "6px";
            approveBtn.onclick = () => approveRequisition(r.id);
            actionCell.appendChild(approveBtn);

            const rejectBtn = document.createElement("button");
            rejectBtn.className = "btn-delete";
            rejectBtn.textContent = "❌ Reject";
            rejectBtn.onclick = () => rejectRequisition(r.id);
            actionCell.appendChild(rejectBtn);

            if (r.id === activeReqId) {
                // Restore focus + cursor position so typing isn't interrupted by the re-render.
                qtyInput.focus();
                try { qtyInput.setSelectionRange(activeSelectionStart, activeSelectionEnd); } catch (e) { /* ignore */ }
            }
        }
    }

    // --- History table: everyone sees their own; admins see everyone's ---
    const visible = isAdmin ? requisitions : requisitions.filter(r => r.requestedBy === currentUserEmail);
    const sorted = [...visible].sort((a, b) => new Date(b.date) - new Date(a.date));
    historyBody.innerHTML = "";
    for (const r of sorted) {
        const row = historyBody.insertRow();
        row.insertCell(0).textContent = r.date || "";
        row.insertCell(1).textContent = r.drug || "";
        row.insertCell(2).textContent = r.location || "";
        row.insertCell(3).textContent = r.qtyRequested || 0;
        row.insertCell(4).textContent = r.qtyApproved != null ? r.qtyApproved : "—";
        row.insertCell(5).textContent = r.unit || "";
        row.insertCell(6).textContent = r.requestedBy || "";

        const statusCell = row.insertCell(7);
        const badge = document.createElement("span");
        badge.textContent = r.status === "pending" ? "⏳ Pending" : r.status === "approved" ? "✅ Approved" : "❌ Rejected";
        badge.style.fontWeight = "600";
        badge.style.color = r.status === "pending" ? "#b7791f" : r.status === "approved" ? "#276749" : "#c53030";
        statusCell.appendChild(badge);

        row.insertCell(8).textContent = r.reviewedBy || "";
        row.insertCell(9).textContent = r.notes || "";
    }
}

function approveRequisition(id) {
    const req = requisitions.find(r => r.id === id);
    if (!req) return;
    if (req.status !== "pending") {
        alert(`⚠️ This request for "${req.drug}" was already ${req.status} (possibly by another admin). Refreshing the list.`);
        renderRequisitions();
        return;
    }

    const qtyInput = document.getElementById("approveQty_" + id);
    const qty = parseInt(qtyInput ? qtyInput.value : req.qtyRequested) || 0;
    if (qty <= 0) {
        alert("Please enter a valid quantity before approving.");
        return;
    }

    const stockItem = inventoryData.find(i => i.name.toLowerCase() === (req.drug || "").toLowerCase());
    if (stockItem && qty > stockItem.balance) {
        if (!confirm(`Only ${stockItem.balance} ${stockItem.unit || ""} of "${req.drug}" is available, but you're approving ${qty}. Continue anyway?`)) {
            return;
        }
    }

    const reviewedBy = currentUserEmail;
    const reviewedAt = new Date().toISOString();

    mutateSharedRequisitions(arr => {
        const target = arr.find(r => r.id === id);
        // If it's no longer pending by the time this transaction actually runs
        // (someone else just approved/rejected it), leave the array untouched -
        // this is what stops an approval from ever silently reverting.
        if (target && target.status === "pending") {
            target.qtyApproved = qty;
            target.status = "approved";
            target.reviewedBy = reviewedBy;
            target.reviewedAt = reviewedAt;
        }
        return arr;
    }).then(updatedArr => {
        requisitions = updatedArr;
        const finalReq = requisitions.find(r => r.id === id);
        renderRequisitions();

        if (finalReq && finalReq.status === "approved" && finalReq.reviewedBy === reviewedBy && finalReq.reviewedAt === reviewedAt) {
            // Our approval actually went through - queue it into Issuing for final processing.
            // Stock is NOT touched yet, exactly like manually adding an issuing entry.
            pendingIssuing.push({
                pendingId: Date.now() + Math.random(),
                date: new Date().toISOString().slice(0, 10),
                drug: req.drug,
                location: req.location,
                batch: "",
                qty: qty,
                unit: req.unit,
                recipient: req.requestedBy,
                issuedBy: currentUserEmail
            });
            renderPendingIssuing();
            alert(`✅ Approved! "${req.drug}" (qty ${qty}) has been added to the Issuing tab's pending list — go there to finish processing it.`);
        } else {
            alert(`⚠️ Someone else already handled "${req.drug}" a moment before you. The list has been refreshed.`);
        }
    }).catch(e => {
        alert("❌ Could not approve, please try again: " + e.message);
    });
}

function rejectRequisition(id) {
    const req = requisitions.find(r => r.id === id);
    if (!req) return;
    if (req.status !== "pending") {
        alert(`⚠️ This request for "${req.drug}" was already ${req.status} (possibly by another admin). Refreshing the list.`);
        renderRequisitions();
        return;
    }
    if (!confirm(`Reject the request for "${req.drug}" (qty ${req.qtyRequested})?`)) return;

    const reviewedBy = currentUserEmail;
    const reviewedAt = new Date().toISOString();

    mutateSharedRequisitions(arr => {
        const target = arr.find(r => r.id === id);
        if (target && target.status === "pending") {
            target.status = "rejected";
            target.reviewedBy = reviewedBy;
            target.reviewedAt = reviewedAt;
        }
        return arr;
    }).then(updatedArr => {
        requisitions = updatedArr;
        renderRequisitions();
    }).catch(e => {
        alert("❌ Could not reject, please try again: " + e.message);
    });
}

// Single source of truth for a drug's stock status so OUT OF STOCK,
// REORDER, and OK are computed the same way everywhere in the app.
function computeStockStatus(balance, reorder) {
    if (balance <= 0) return "OUT OF STOCK";
    if (balance <= reorder) return "REORDER";
    return "OK";
}
let sortConfig = { key: 'name', direction: 'asc' };
let systemInitialized = false;
let editingItemId = null;

function getExpiryStatus(expiryDate) {
    if (!expiryDate || expiryDate === "") return { status: "No Date", class: "badge-ok", daysLeft: null };
    const today = new Date();
    today.setHours(0, 0, 0, 0);
    const expiry = new Date(expiryDate);
    expiry.setHours(0, 0, 0, 0);
    const daysLeft = Math.ceil((expiry - today) / (1000 * 60 * 60 * 24));
    if (daysLeft < 0) return { status: "EXPIRED", class: "badge-expired", daysLeft: daysLeft };
    if (daysLeft <= 300) return { status: "Expiring Soon", class: "badge-expiring-soon", daysLeft: daysLeft };
    return { status: "Good", class: "badge-good", daysLeft: daysLeft };
}

// Escapes text before it's dropped into innerHTML, so a drug/location name
// containing characters like < > " ' can't break the layout or inject markup.
function escapeHtml(text) {
    const div = document.createElement('div');
    div.textContent = text ?? '';
    return div.innerHTML;
}

function generateId() {
    const maxId = inventoryData.reduce((max, item) => {
        const num = parseInt(item.id.replace('D', ''));
        return num > max ? num : max;
    }, 0);
    return "D" + String(maxId + 1).padStart(3, '0');
}

// Requisitions get their own ID sequence (prefixed "R") so they never collide
// with inventory drug IDs, which are generated separately above.
function generateRequisitionId() {
    return "R" + Date.now().toString(36).toUpperCase() + Math.floor(Math.random() * 1000);
}

