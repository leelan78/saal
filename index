// Applies one pending issue entry against current stock levels.
// Returns { success, message } — failures are left in the pending list so
// staff can fix or remove them instead of silently losing the entry.
function commitIssuingEntry(entry) {
    let found = false;
    let result = { success: true, message: "" };

    for (let item of inventoryData) {
        if (item.name.toLowerCase() === entry.drug.toLowerCase()) {
            found = true;
            if (item.balance >= entry.qty) {
                item.issued += entry.qty;
                item.balance = item.opening + item.received - item.issued;
                item.status = computeStockStatus(item.balance, item.reorder);
                if (entry.location) item.location = entry.location;
                if (entry.unit) item.unit = entry.unit;
            } else {
                result.success = false;
                result.message = `"${entry.drug}": insufficient stock (wanted ${entry.qty}, have ${item.balance})`;
            }
            break;
        }
    }

    if (!found) {
        result.success = false;
        result.message = `"${entry.drug}": not found in inventory`;
    }

    if (result.success) {
        issuingData.unshift({
            id: Date.now() + Math.random(),
            date: entry.date,
            drug: entry.drug,
            location: entry.location,
            batch: entry.batch,
            qty: entry.qty,
            unit: entry.unit,
            recipient: entry.recipient,
            issuedBy: entry.issuedBy
        });
    }

    return result;
}

function processAllIssuing() {
    if (pendingIssuing.length === 0) {
        alert("No pending issuing entries to process.");
        return;
    }
    if (!confirm(`Process ${pendingIssuing.length} issuing entr${pendingIssuing.length === 1 ? 'y' : 'ies'} and update inventory?`)) {
        return;
    }

    const failures = [];
    const stillPending = [];
    let successCount = 0;

    for (const entry of pendingIssuing) {
        const result = commitIssuingEntry(entry);
        if (result.success) {
            successCount++;
        } else {
            failures.push(result.message);
            stillPending.push(entry); // leave failed entries in the list to fix/remove
        }
    }

    pendingIssuing = stillPending;

    saveAll();
    renderPendingIssuing();
    displayIssuing();
    refreshInventory();
    refreshExpiryTracker();
    updateDashboardStats();

    if (failures.length === 0) {
        alert(`✅ ${successCount} issuing entr${successCount === 1 ? 'y' : 'ies'} processed! Inventory updated.`);
    } else {
        alert(`✅ ${successCount} processed.\n⚠️ ${failures.length} could not be processed and remain in the pending list:\n\n${failures.join('\n')}`);
    }
}

