// Looks up the drug currently typed in the Receiving form and, if it already
// exists in inventory, auto-fills its location and shows the quantity
// currently on hand — so staff can see stock levels while still typing
// whatever quantity was actually received.
function updateReceiveAvailability() {
    const drugName = document.getElementById("receiptDrug").value.trim();
    const hint = document.getElementById("receiveAvailableQty");
    const expiryHint = document.getElementById("receiveExpiryHint");
    const locationField = document.getElementById("receiptLocation");
    const unitField = document.getElementById("receiptUnit");
    if (!hint || !locationField || !unitField) return;

    if (!drugName) {
        hint.textContent = "";
        hint.className = "field-hint";
        if (expiryHint) { expiryHint.textContent = ""; expiryHint.className = "field-hint"; }
        return;
    }

    const item = inventoryData.find(i => i.name.toLowerCase() === drugName.toLowerCase());

    if (item) {
        locationField.value = item.location || "";
        if (item.unit && !unitField.value) unitField.value = item.unit;
        hint.textContent = `📦 Currently in stock: ${item.balance} ${item.unit || ""} at ${item.location || "no location set"}`;
        hint.className = "field-hint";
        if (expiryHint) {
            if (item.expiryDate) {
                const expiryInfo = getExpiryStatus(item.expiryDate);
                expiryHint.textContent = `📅 Current expiry on file: ${item.expiryDate}${expiryInfo.status === "EXPIRED" ? " (EXPIRED)" : ""}`;
                expiryHint.className = expiryInfo.status === "EXPIRED" ? "field-hint warning" : "field-hint";
            } else {
                expiryHint.textContent = "📅 No expiry currently on file for this drug";
                expiryHint.className = "field-hint";
            }
        }
    } else {
        hint.textContent = "🆕 New drug — will be added to inventory when processed";
        hint.className = "field-hint warning";
        if (expiryHint) { expiryHint.textContent = ""; expiryHint.className = "field-hint"; }
    }
}

function addReceivingToPending() {
    const location = document.getElementById("receiptLocation").value.trim();
    const unit = document.getElementById("receiptUnit").value.trim();
