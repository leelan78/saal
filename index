// EMBEDDED DATA SNAPSHOT (carries data when the file is shared)
// ============================================================

// Writes a snapshot's data into localStorage.
function applySnapshot(snapshot) {
    if (snapshot.inventoryData) localStorage.setItem('pharmacy_inventory', JSON.stringify(snapshot.inventoryData));
    if (snapshot.receivingData) localStorage.setItem('pharmacy_receiving', JSON.stringify(snapshot.receivingData));
    if (snapshot.issuingData) localStorage.setItem('pharmacy_issuing', JSON.stringify(snapshot.issuingData));
    if (snapshot.returnsData) localStorage.setItem('pharmacy_returns', JSON.stringify(snapshot.returnsData));
    if (snapshot.customLocations) localStorage.setItem('pharmacy_custom_locations', JSON.stringify(snapshot.customLocations));
    if (snapshot.customUnits) localStorage.setItem('pharmacy_custom_units', JSON.stringify(snapshot.customUnits));
    if (snapshot.customSuppliers) localStorage.setItem('pharmacy_custom_suppliers', JSON.stringify(snapshot.customSuppliers));
    if (snapshot.customReceivedBy) localStorage.setItem('pharmacy_custom_receivedby', JSON.stringify(snapshot.customReceivedBy));
    if (snapshot.customRecipients) localStorage.setItem('pharmacy_custom_recipients', JSON.stringify(snapshot.customRecipients));
    if (snapshot.customLocations) localStorage.setItem('pharmacy_locations_seeded', '1');
    if (snapshot.savedAt) localStorage.setItem('pharmacy_last_imported_snapshot', snapshot.savedAt);
    // This data was explicitly chosen by the user - it should be pushed up to
    // the shared database, not silently overwritten by what's already there.
    localStorage.setItem('pharmacy_pending_push', '1');
}

// Runs on every page load. If this copy of the file has a snapshot baked in
// (from "Save & Share") that hasn't already been imported into this browser,
// ask before loading it in. Unlike the earlier version of this check, this
// no longer gets blocked just because the browser has empty [] arrays sitting
// in storage from a previous, data-less run of the app.
function loadEmbeddedSnapshotIfPresent() {
    try {
        const dataEl = document.getElementById('embeddedDataStore');
        if (!dataEl) return;
        const raw = dataEl.textContent.trim();
        if (!raw || raw === '{}') return;

        const snapshot = JSON.parse(raw);
        const itemCount = (snapshot.inventoryData && snapshot.inventoryData.length) || 0;
        const recvCount = (snapshot.receivingData && snapshot.receivingData.length) || 0;
        const issueCount = (snapshot.issuingData && snapshot.issuingData.length) || 0;
        if (itemCount === 0 && recvCount === 0 && issueCount === 0) return;

        // Don't re-ask for a snapshot we already imported on this device.
        if (snapshot.savedAt && localStorage.getItem('pharmacy_last_imported_snapshot') === snapshot.savedAt) return;

        const savedLabel = snapshot.savedAt ? new Date(snapshot.savedAt).toLocaleString() : 'an earlier session';
        const proceed = confirm(
            `This file has saved pharmacy data bundled in it (${itemCount} drug record(s), saved ${savedLabel}).\n\n` +
            `Load it into this browser now?\n\nOK = load it (replaces what's currently stored here)\nCancel = keep what's already on this device`
        );

        if (snapshot.savedAt) localStorage.setItem('pharmacy_last_imported_snapshot', snapshot.savedAt);
        if (!proceed) return;

        applySnapshot(snapshot);
    } catch (e) {
        console.warn('Could not load embedded snapshot:', e);
    }
}

// Manual fallback: lets someone pick a previously-shared Gaki HTML file at
// any time (not just first launch) and load its bundled data in directly.
// Useful if the automatic prompt above didn't fire for any reason.
function importSnapshotFile(event) {
    const file = event.target.files && event.target.files[0];
    event.target.value = ''; // reset so picking the same file again still fires 'change'
    if (!file) return;

    const reader = new FileReader();
    reader.onload = function(e) {
        try {
            const text = e.target.result;
            const match = text.match(/<script[^>]*id=["']embeddedDataStore["'][^>]*>([\s\S]*?)<\/script>/i);
            const raw = match ? match[1].trim() : text.trim();

            if (!raw || raw === '{}') {
                alert('⚠️ No saved data found in that file.');
                return;
            }

            const snapshot = JSON.parse(raw);
            const itemCount = (snapshot.inventoryData && snapshot.inventoryData.length) || 0;
            const savedLabel = snapshot.savedAt ? ', saved ' + new Date(snapshot.savedAt).toLocaleString() : '';
            const proceed = confirm(`Found ${itemCount} drug record(s) in that file${savedLabel}.\n\nLoad this into the app now? This will replace what is currently stored here.`);
            if (!proceed) return;

            applySnapshot(snapshot);
            alert('✅ Data loaded! Reloading the app...');
            location.reload();
        } catch (err) {
            alert('❌ Could not read that file: ' + err.message);
        }
    };
    reader.readAsText(file);
}

// Lets someone pick a second Gaki HTML file (e.g. from another device) and
// FOLD its data into what's currently loaded here, instead of replacing it.
// Drugs are matched by name+location so nothing gets duplicated; matches keep
// the higher figures instead of blindly overwriting. Receiving/issuing rows
// and location/supplier/etc. suggestion lists are merged the same way.
function mergeSnapshotFile(event) {
    const file = event.target.files && event.target.files[0];
    event.target.value = '';
    if (!file) return;

    const reader = new FileReader();
    reader.onload = function(e) {
        try {
            const text = e.target.result;
            const match = text.match(/<script[^>]*id=["']embeddedDataStore["'][^>]*>([\s\S]*?)<\/script>/i);
            const raw = match ? match[1].trim() : text.trim();

            if (!raw || raw === '{}') {
                alert('⚠️ No saved data found in that file.');
                return;
            }

            const snapshot = JSON.parse(raw);
            const itemCount = (snapshot.inventoryData && snapshot.inventoryData.length) || 0;
            const savedLabel = snapshot.savedAt ? ', saved ' + new Date(snapshot.savedAt).toLocaleString() : '';
            const proceed = confirm(`Found ${itemCount} drug record(s) in that file${savedLabel}.\n\nMerge this into the currently loaded data? Duplicates will be skipped/updated — nothing currently loaded will be deleted.`);
            if (!proceed) return;

            const summary = mergeSnapshotData(snapshot);
            saveAll();
            renderAll();
            alert(
                `✅ Merge complete!\n\n` +
                `➕ ${summary.addedDrugs} new drug(s) added\n` +
                `🔄 ${summary.updatedDrugs} existing drug(s) updated (higher figures kept)\n` +
                `📥 ${summary.addedReceiving} receiving record(s) added\n` +
                `📤 ${summary.addedIssuing} issuing record(s) added\n` +
                `🔄 ${summary.addedReturns} returned goods record(s) added\n` +
                `🗂️ ${summary.addedListValues} suggestion-list value(s) added (locations/suppliers/etc.)`
            );
        } catch (err) {
            alert('❌ Could not read that file: ' + err.message);
        }
    };
    reader.readAsText(file);
}

// Does the actual merging described above and returns counts for the summary
// alert. Kept separate from mergeSnapshotFile() so it's easy to test/reuse.
function mergeSnapshotData(snapshot) {
    let addedDrugs = 0, updatedDrugs = 0, addedReceiving = 0, addedIssuing = 0, addedReturns = 0, addedListValues = 0;

    if (Array.isArray(snapshot.inventoryData)) {
        for (const incoming of snapshot.inventoryData) {
            if (!incoming || !incoming.name) continue;
            const existing = inventoryData.find(i =>
                i.name.toLowerCase() === incoming.name.toLowerCase() &&
                (i.location || '').toLowerCase() === (incoming.location || '').toLowerCase()
            );
            if (existing) {
                // Keep the larger figures instead of overwriting, so merging can't
                // accidentally erase stock that only exists on this device.
                existing.opening = Math.max(existing.opening || 0, incoming.opening || 0);
                existing.received = Math.max(existing.received || 0, incoming.received || 0);
                existing.issued = Math.max(existing.issued || 0, incoming.issued || 0);
                existing.balance = Math.max(existing.balance || 0, incoming.balance || 0);
                if (!existing.unit && incoming.unit) existing.unit = incoming.unit;
                if (!existing.expiryDate && incoming.expiryDate) existing.expiryDate = incoming.expiryDate;
                if (!existing.reorder) existing.reorder = incoming.reorder || existing.reorder;
                existing.status = computeStockStatus(existing.balance, existing.reorder);
                updatedDrugs++;
            } else {
                const usedIds = new Set(inventoryData.map(i => i.id));
                inventoryData.push({
                    ...incoming,
                    id: (incoming.id && !usedIds.has(incoming.id)) ? incoming.id : generateId()
                });
                addedDrugs++;
            }
        }
    }

    if (Array.isArray(snapshot.receivingData)) {
        for (const r of snapshot.receivingData) {
            const dup = receivingData.some(x => x.date === r.date && x.drug === r.drug && x.qty === r.qty && x.location === r.location);
            if (!dup) { receivingData.push({ ...r, id: Date.now() + Math.random() }); addedReceiving++; }
        }
        receivingData.sort((a, b) => new Date(b.date) - new Date(a.date));
    }

    if (Array.isArray(snapshot.issuingData)) {
        for (const r of snapshot.issuingData) {
            const dup = issuingData.some(x => x.date === r.date && x.drug === r.drug && x.qty === r.qty && x.location === r.location);
            if (!dup) { issuingData.push({ ...r, id: Date.now() + Math.random() }); addedIssuing++; }
        }
        issuingData.sort((a, b) => new Date(b.date) - new Date(a.date));
    }

    if (Array.isArray(snapshot.returnsData)) {
        for (const r of snapshot.returnsData) {
            const dup = returnsData.some(x => x.date === r.date && x.drug === r.drug && x.qty === r.qty && x.location === r.location);
            if (!dup) { returnsData.push({ ...r, id: Date.now() + Math.random() }); addedReturns++; }
        }
        returnsData.sort((a, b) => new Date(b.date) - new Date(a.date));
    }

    const listSources = [
        [snapshot.customLocations, rememberLocationIfNew],
        [snapshot.customUnits, rememberUnitIfNew],
        [snapshot.customSuppliers, rememberSupplierIfNew],
        [snapshot.customReceivedBy, rememberReceivedByIfNew],
        [snapshot.customRecipients, rememberRecipientIfNew]
    ];
    for (const [values, rememberFn] of listSources) {
        if (!Array.isArray(values)) continue;
        for (const v of values) {
            const before = customLocations.length + customUnits.length + customSuppliers.length + customReceivedBy.length + customRecipients.length;
            rememberFn(v);
            const after = customLocations.length + customUnits.length + customSuppliers.length + customReceivedBy.length + customRecipients.length;
            if (after > before) addedListValues++;
        }
    }

    return { addedDrugs, updatedDrugs, addedReceiving, addedIssuing, addedReturns, addedListValues };
}

// Downloads a new copy of this whole file with the current data baked in,
// so sending that file to another device and opening it brings the data along.
// Note: the login password is NOT included in the snapshot for safety — the
// other device will need the same login it already has, or the default one.
function exportSnapshotHtml() {
    try {
        const snapshot = {
            inventoryData: inventoryData,
            receivingData: receivingData,
            issuingData: issuingData,
            returnsData: returnsData,
            customLocations: customLocations,
            customUnits: customUnits,
            customSuppliers: customSuppliers,
            customReceivedBy: customReceivedBy,
            customRecipients: customRecipients,
            savedAt: new Date().toISOString()
        };
        // Escape "</" so the JSON can't accidentally close the surrounding <script> tag.
        const json = JSON.stringify(snapshot).replace(/<\//g, '<\\/');

        const clone = document.documentElement.cloneNode(true);

        // Reset session/visual state so the shared copy opens at the login screen,
        // not mid-session or with a modal stuck open.
        const loginForm = clone.querySelector('#loginForm');
        const mainApp = clone.querySelector('#mainApp');
        if (loginForm) loginForm.style.display = 'block';
        if (mainApp) mainApp.style.display = 'none';
        ['addDrugModal', 'passwordModal'].forEach(id => {
            const el = clone.querySelector('#' + id);
            if (el) el.style.display = 'none';
        });

        const dataEl = clone.querySelector('#embeddedDataStore');
        if (dataEl) dataEl.textContent = json;

        const html = '<!DOCTYPE html>\n' + clone.outerHTML;
        const blob = new Blob([html], { type: 'text/html;charset=utf-8;' });
        const url = URL.createObjectURL(blob);
        const link = document.createElement('a');
        link.href = url;
        const dateStr = new Date().toISOString().split('T')[0];
        link.download = `Gaki_${dateStr}.html`;
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
        setTimeout(() => URL.revokeObjectURL(url), 5000);
        alert(`✅ Saved as "Gaki_${dateStr}.html". Send THIS new file (not the old one) to the other device.\n\nWhen it's opened there, you'll be asked whether to load the data in — say yes.`);
    } catch (e) {
        alert('❌ Could not create the shareable file: ' + e.message);
    }
}

