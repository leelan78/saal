// ============================================================
// INVENTORY SYSTEM - NO SAMPLE DATA
// ============================================================

let receivingData = [];
let issuingData = [];
let returnsData = [];
let inventoryData = [];
let requisitions = [];

// ============================================================
// FIREBASE (shared live database so every device sees the same data)
// ============================================================
let firestoreReady = false;      // becomes true once we've received the first snapshot
let applyingRemoteUpdate = false; // guards against re-broadcasting our own incoming update
let saveDebounceTimer = null;

// Pushes the current in-memory data up to Firestore immediately - no delay,
// so a quick refresh right after saving can never race ahead of the write
// and pull older data back down.
function pushToFirestore() {
    if (applyingRemoteUpdate) return; // don't echo back data we just received
    sharedDocRef.set({
        inventoryData,
        receivingData,
        issuingData,
        returnsData,
        requisitions,
        customLocations,
        customUnits,
        customSuppliers,
        customReceivedBy,
        customRecipients,
        updatedAt: firebase.firestore.FieldValue.serverTimestamp()
    }, { merge: true }).catch(e => console.warn('Firestore save error:', e));
}

// Listens for changes from Firestore (made by this device or any other) and
// updates the screen live. This is what makes the app "multi-user real-time".
function startFirestoreSync() {
    sharedDocRef.onSnapshot((doc) => {
        // If the user just loaded/merged data from a file, that data should
        // WIN and get pushed up - not get silently overwritten by whatever
        // was already sitting in the shared database.
        if (localStorage.getItem('pharmacy_pending_push') === '1') {
            localStorage.removeItem('pharmacy_pending_push');
            firestoreReady = true;
            pushToFirestore();
            return;
        }

        if (!doc.exists) {
            // First time ever — seed Firestore with whatever is currently local.
            firestoreReady = true;
            pushToFirestore();
            return;
        }
        const data = doc.data();
        applyingRemoteUpdate = true;
        inventoryData = data.inventoryData || [];
        receivingData = data.receivingData || [];
        issuingData = data.issuingData || [];
        returnsData = data.returnsData || [];
        requisitions = data.requisitions || [];
        customLocations = data.customLocations || customLocations;
        customUnits = data.customUnits || customUnits;
        customSuppliers = data.customSuppliers || customSuppliers;
        customReceivedBy = data.customReceivedBy || customReceivedBy;
        customRecipients = data.customRecipients || customRecipients;

        // Keep localStorage as an offline cache too.
        try {
            localStorage.setItem('pharmacy_inventory', JSON.stringify(inventoryData));
            localStorage.setItem('pharmacy_receiving', JSON.stringify(receivingData));
            localStorage.setItem('pharmacy_issuing', JSON.stringify(issuingData));
            localStorage.setItem('pharmacy_returns', JSON.stringify(returnsData));
        } catch (e) { /* ignore quota errors */ }

        if (systemInitialized) {
            renderAll();
            renderRequisitions();
            checkForNewRequisitions();
        }
        firestoreReady = true;
        applyingRemoteUpdate = false;
    }, (error) => {
        console.warn('Firestore sync error (staying on local data):', error);
    });
}

// ============================================================
// NOTIFICATIONS - lets an admin know right away when staff submit a new
// request, without them having to keep checking the Requests tab.
// ============================================================

// Requests IDs already surfaced to this admin on this device, so a page
// refresh (or a snapshot re-fire) doesn't notify about the same request twice.
let notifiedRequisitionIds = new Set(JSON.parse(localStorage.getItem('pharmacy_notified_reqs') || '[]'));

function saveNotifiedRequisitionIds() {
    // Keep this list from growing forever - only the most recent 500 IDs are needed.
    const arr = Array.from(notifiedRequisitionIds).slice(-500);
    localStorage.setItem('pharmacy_notified_reqs', JSON.stringify(arr));
}

function showToast(message, kind) {
    const container = document.getElementById("toastContainer");
    if (!container) return;
    const toast = document.createElement("div");
    toast.style.background = kind === "warning" ? "#fffaf0" : "#ebf8ff";
    toast.style.border = "1px solid " + (kind === "warning" ? "#dd6b20" : "#2c5282");
    toast.style.color = "#1a202c";
    toast.style.padding = "14px 16px";
    toast.style.borderRadius = "10px";
    toast.style.boxShadow = "0 8px 20px rgba(0,0,0,0.15)";
    toast.style.fontSize = "14px";
    toast.style.cursor = "pointer";
    toast.textContent = message;
    toast.onclick = () => {
        toast.remove();
        // Jump straight to the Requests tab so the admin can act on it.
        const reqTabBtn = Array.from(document.getElementsByClassName("tablinks")).find(b => b.textContent.includes("REQUESTS"));
        if (reqTabBtn) reqTabBtn.click();
    };
    container.appendChild(toast);
    setTimeout(() => toast.remove(), 10000);
}

// Browser (OS-level) notification, in addition to the in-app toast, so an
// admin sees it even if the tab isn't focused. Falls back silently if the
// user hasn't granted permission - the in-app toast + badge still work.
function showBrowserNotification(title, body) {
    if (!("Notification" in window)) return;
    if (Notification.permission === "granted") {
        try { new Notification(title, { body: body, icon: "" }); } catch (e) { /* ignore */ }
    }
}

function requestNotificationPermission() {
    if ("Notification" in window && Notification.permission === "default") {
        Notification.requestPermission();
    }
}

// Compares the requisitions list just pulled down from Firestore against
// what this admin has already been told about, and raises an alert for
// anything new and still pending.
function checkForNewRequisitions() {
    if (currentUserRole !== "admin") return;
    const newlyPending = requisitions.filter(r => r.status === "pending" && !notifiedRequisitionIds.has(r.id));
    if (newlyPending.length === 0) return;

    for (const r of newlyPending) {
        notifiedRequisitionIds.add(r.id);
    }
    saveNotifiedRequisitionIds();

    if (newlyPending.length === 1) {
        const r = newlyPending[0];
        showToast(`🙋 New request: ${r.drug} (qty ${r.qtyRequested}) from ${r.requestedBy}`, "warning");
        showBrowserNotification("New drug request", `${r.drug} (qty ${r.qtyRequested}) requested by ${r.requestedBy}`);
    } else {
        showToast(`🙋 ${newlyPending.length} new drug requests need your review`, "warning");
        showBrowserNotification("New drug requests", `${newlyPending.length} new requests need your review`);
    }
}

