function loadCustomLists() {
    try {
        customLocations = JSON.parse(localStorage.getItem('pharmacy_custom_locations') || '[]');
    } catch (e) { customLocations = []; }
    try {
        customUnits = JSON.parse(localStorage.getItem('pharmacy_custom_units') || '[]');
    } catch (e) { customUnits = []; }
    try {
        customSuppliers = JSON.parse(localStorage.getItem('pharmacy_custom_suppliers') || '[]');
    } catch (e) { customSuppliers = []; }
    try {
        customReceivedBy = JSON.parse(localStorage.getItem('pharmacy_custom_receivedby') || '[]');
    } catch (e) { customReceivedBy = []; }
    try {
        customRecipients = JSON.parse(localStorage.getItem('pharmacy_custom_recipients') || '[]');
    } catch (e) { customRecipients = []; }
    ensureLocationsSeeded();
}

function saveCustomLists() {
    try {
        localStorage.setItem('pharmacy_custom_locations', JSON.stringify(customLocations));
        localStorage.setItem('pharmacy_custom_units', JSON.stringify(customUnits));
        localStorage.setItem('pharmacy_custom_suppliers', JSON.stringify(customSuppliers));
        localStorage.setItem('pharmacy_custom_receivedby', JSON.stringify(customReceivedBy));
        localStorage.setItem('pharmacy_custom_recipients', JSON.stringify(customRecipients));
    } catch (e) {}
    pushToFirestore();
}

// Locations start out as DEFAULT_LOCATIONS + whatever staff had typed in before.
// This runs once (per browser) to fold the defaults into the editable
// customLocations list itself, so that the Setup > Manage Lists screen can
// delete a "default" location too, instead of it reappearing every reload.
function ensureLocationsSeeded() {
    if (localStorage.getItem('pharmacy_locations_seeded')) return;
    const seen = new Set(customLocations.map(l => l.toLowerCase()));
    for (const loc of DEFAULT_LOCATIONS) {
        if (!seen.has(loc.toLowerCase())) { customLocations.push(loc); seen.add(loc.toLowerCase()); }
    }
    localStorage.setItem('pharmacy_locations_seeded', '1');
    saveCustomLists();
}

function getAllLocations() {
    const seen = new Set();
    const all = [];
    for (const loc of customLocations) {
        const key = loc.toLowerCase();
        if (!seen.has(key)) { seen.add(key); all.push(loc); }
    }
    return all;
}

function getAllSuppliers() {
    const seen = new Set();
    const all = [];
    for (const s of customSuppliers) {
        const key = s.toLowerCase();
        if (!seen.has(key)) { seen.add(key); all.push(s); }
    }
    return all;
}

function getAllReceivedBy() {
    const seen = new Set();
    const all = [];
    for (const s of customReceivedBy) {
        const key = s.toLowerCase();
        if (!seen.has(key)) { seen.add(key); all.push(s); }
    }
    return all;
}

function getAllRecipients() {
    const seen = new Set();
    const all = [];
    for (const s of customRecipients) {
        const key = s.toLowerCase();
        if (!seen.has(key)) { seen.add(key); all.push(s); }
    }
    return all;
}

function getAllUnits() {
    const seen = new Set();
    const all = [];
    for (const u of [...DEFAULT_UNITS, ...customUnits]) {
        const key = u.toLowerCase();
        if (!seen.has(key)) { seen.add(key); all.push(u); }
    }
    return all;
}

// If someone typed a location that isn't already in the dropdown, remember it
// for next time instead of only accepting picks from the popup list.
function rememberLocationIfNew(value) {
    if (!value) return;
    if (!getAllLocations().some(l => l.toLowerCase() === value.toLowerCase())) {
        customLocations.push(value);
        saveCustomLists();
        populateLocationDatalists();
    }
}

// Same idea for units (Vials, Cartons, Packs, Ampoules, or anything custom typed in).
function rememberUnitIfNew(value) {
    if (!value) return;
    if (!getAllUnits().some(u => u.toLowerCase() === value.toLowerCase())) {
        customUnits.push(value);
        saveCustomLists();
        populateUnitDatalists();
    }
}

// Same idea for suppliers typed into the Receiving form.
function rememberSupplierIfNew(value) {
    if (!value) return;
    if (!getAllSuppliers().some(s => s.toLowerCase() === value.toLowerCase())) {
        customSuppliers.push(value);
        saveCustomLists();
        populateSupplierDatalists();
    }
}

// Same idea for "Received By" staff names typed into the Receiving form.
function rememberReceivedByIfNew(value) {
    if (!value) return;
    if (!getAllReceivedBy().some(s => s.toLowerCase() === value.toLowerCase())) {
        customReceivedBy.push(value);
        saveCustomLists();
        populateReceivedByDatalists();
    }
}

// Same idea for recipients typed into the Issuing form.
function rememberRecipientIfNew(value) {
    if (!value) return;
