// ROLES (admin vs staff) — stored in Firestore, one doc per team member.
// The very first person ever to log in (when no team docs exist yet)
// automatically becomes admin, so there's always at least one admin
// without anyone needing to hand-configure it.
// ============================================================
let currentUserRole = "staff";
let currentUserEmail = "";

async function resolveUserRole(user) {
    currentUserEmail = user.email;
    const userRef = db.collection("gaki_users").doc(user.uid);
    try {
        const docSnap = await userRef.get();
        if (docSnap.exists) {
            currentUserRole = docSnap.data().role || "staff";
        } else {
            const anyUsers = await db.collection("gaki_users").limit(1).get();
            const isFirstEver = anyUsers.empty;
            currentUserRole = isFirstEver ? "admin" : "staff";
            await userRef.set({
                email: user.email,
                role: currentUserRole,
                createdAt: firebase.firestore.FieldValue.serverTimestamp()
            });
        }
    } catch (e) {
        console.warn("Could not resolve user role, defaulting to staff:", e);
        currentUserRole = "staff";
    }

    const manageBtn = document.getElementById("manageTeamBtn");
    if (manageBtn) manageBtn.style.display = currentUserRole === "admin" ? "inline-block" : "none";
    renderRequisitions();

    if (currentUserRole === "admin") {
        requestNotificationPermission();
        if (localStorage.getItem('pharmacy_notified_reqs') === null) {
            // First time this device has ever checked - treat whatever is
            // already pending as "known" rather than firing a burst of alerts
            // for old requests. Only genuinely new ones from here on notify.
            for (const r of requisitions) {
                if (r.status === "pending") notifiedRequisitionIds.add(r.id);
            }
            saveNotifiedRequisitionIds();
        } else {
            checkForNewRequisitions();
        }
    }
}

