async function savePassword() {
    const current = document.getElementById("currentPwd").value.trim();
    const newPwd = document.getElementById("newPwd").value.trim();
    const confirmPwdVal = document.getElementById("confirmPwd").value.trim();
    const msgEl = document.getElementById("pwdMsg");
    const user = auth.currentUser;

    msgEl.className = "modal-msg";

    if (!user) {
        msgEl.className = "modal-msg error";
        msgEl.textContent = "❌ You must be logged in to change your password.";
        return;
    }

    if (newPwd.length < 6) {
        msgEl.className = "modal-msg error";
        msgEl.textContent = "❌ New password must be at least 6 characters!";
        return;
    }

    if (newPwd !== confirmPwdVal) {
        msgEl.className = "modal-msg error";
        msgEl.textContent = "❌ Passwords do not match!";
        return;
    }

    if (newPwd === current) {
        msgEl.className = "modal-msg error";
        msgEl.textContent = "❌ New password must be different from current!";
        return;
    }

    try {
        // Firebase requires you to re-prove your current password before
        // allowing a password change - this re-authenticates first.
        const cred = firebase.auth.EmailAuthProvider.credential(user.email, current);
        await user.reauthenticateWithCredential(cred);
        await user.updatePassword(newPwd);
        msgEl.className = "modal-msg success";
        msgEl.textContent = "✅ Password changed successfully!";
        setTimeout(() => {
            closePasswordModal();
        }, 1500);
    } catch (e) {
        msgEl.className = "modal-msg error";
        msgEl.textContent = e.code === "auth/wrong-password" || e.code === "auth/invalid-credential"
            ? "❌ Current password is incorrect!"
            : friendlyAuthError(e.code);
    }
}

