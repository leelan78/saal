function exportToExcel() {
    if(inventoryData.length === 0) {
        alert("No data to export!");
        return;
    }
    let csv = "Drug ID,Drug/Item,Location,Unit,Opening Stock,Received Qty,Issued Qty,Balance,Reorder Level,Status,Expiry Date,Expiry Status\n";
    inventoryData.forEach(item => {
        const expiryInfo = getExpiryStatus(item.expiryDate);
        csv += `"${item.id}","${item.name}","${item.location}","${item.unit || ""}",${item.opening},${item.received},${item.issued},${item.balance},${item.reorder},"${item.status}","${item.expiryDate || ""}","${expiryInfo.status}"\n`;
    });
    const blob = new Blob(["\uFEFF" + csv], { type: "text/csv;charset=utf-8;" });
    const link = document.createElement("a");
    link.href = URL.createObjectURL(blob);
    link.download = "inventory_export.csv";
    link.click();
}

function exportExpiryReport() {
    if(inventoryData.length === 0) {
        alert("No data to export!");
        return;
    }
    let csv = "Drug ID,Drug/Item,Location,Unit,Current Balance,Expiry Date,Days Until Expiry,Status,Action Required\n";
    inventoryData.forEach(item => {
        const expiryInfo = getExpiryStatus(item.expiryDate);
        let action = "";
        if(expiryInfo.status === "EXPIRED") action = "DISCARD IMMEDIATELY";
        else if(expiryInfo.status === "Expiring Soon") action = "Use first / Move to front";
        else if(!item.expiryDate) action = "Add expiry date";
        else action = "OK";
        csv += `"${item.id}","${item.name}","${item.location}","${item.unit || ""}",${item.balance},"${item.expiryDate || ""}",${expiryInfo.daysLeft !== null ? expiryInfo.daysLeft : "N/A"},"${expiryInfo.status}","${action}"\n`;
    });
    const blob = new Blob(["\uFEFF" + csv], { type: "text/csv;charset=utf-8;" });
    const link = document.createElement("a");
    link.href = URL.createObjectURL(blob);
    link.download = "expiry_tracker_report.csv";
    link.click();
}

