    if (resolvedLocation) rememberLocationIfNew(resolvedLocation);
    if (resolvedUnit) rememberUnitIfNew(resolvedUnit);

    renderPendingRequisitions();
    clearRequisitionForm(true);
    document.getElementById("reqDrug").focus();
