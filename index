        el.style.boxShadow = '0 0 0 3px rgba(214,158,46,0.2)';
    }
}

function cancelEditItem() {
    editingItemId = null;
    renderSetupItems();
}

function saveEditItem(id) {
    const item = inventoryData.find(i => i.id === id);
    if (!item) {
        alert('Item not found!');
        return;
    }
    
    const newName = document.getElementById(`edit-name-${id}`).value.trim();
    const newLocation = document.getElementById(`edit-location-${id}`).value.trim();
    const newBalance = parseInt(document.getElementById(`edit-balance-${id}`).value) || 0;
    const newUnit = document.getElementById(`edit-unit-${id}`).value.trim();
    const newExpiry = document.getElementById(`edit-expiry-${id}`).value;
    const newOpening = parseInt(document.getElementById(`edit-opening-${id}`).value) || 0;
    const newReceived = parseInt(document.getElementById(`edit-received-${id}`).value) || 0;
    const newIssued = parseInt(document.getElementById(`edit-issued-${id}`).value) || 0;
    const newReorder = parseInt(document.getElementById(`edit-reorder-${id}`).value) || 20;
    
    if (!newName) {
        alert('Drug name cannot be empty!');
        return;
    }
    
    if (!newLocation) {
        alert('Please enter a Location!');
        return;
    }
    
    const duplicate = inventoryData.some(i => 
        i.id !== id && i.name.toLowerCase() === newName.toLowerCase()
    );
    if (duplicate) {
        alert(`⚠️ Drug "${newName}" already exists in inventory!`);
        return;
    }
    
    item.name = newName;
    item.location = newLocation;
    item.balance = newBalance;
    item.unit = newUnit;
    item.expiryDate = newExpiry;
    item.opening = newOpening;
    item.received = newReceived;
    item.issued = newIssued;
    item.reorder = newReorder;
    item.status = computeStockStatus(newBalance, newReorder);
    
    rememberLocationIfNew(newLocation);
    rememberUnitIfNew(newUnit);
    saveAll();
    editingItemId = null;
    renderSetupItems();
    refreshInventory();
    refreshExpiryTracker();
    updateDashboardStats();
    updateDrugSuggestions();
    alert(`✅ Drug "${newName}" updated successfully!`);
}

function deleteItem(id) {
    const item = inventoryData.find(i => i.id === id);
    if (!item) {
        alert('Item not found!');
        return;
    }
    
    const confirmDelete = confirm(
        `⚠️ Are you sure you want to delete "${item.name}" (${item.id}) from inventory?\n\n` +
        `📦 Current Balance: ${item.balance}\n` +
        `📍 Location: ${item.location || 'N/A'}\n` +
        `📅 Expiry: ${item.expiryDate || 'Not set'}\n\n` +
        `This action cannot be undone!`
    );
    
    if (confirmDelete) {
        const index = inventoryData.findIndex(i => i.id === id);
        if (index !== -1) {
            const deletedItem = inventoryData[index];
            inventoryData.splice(index, 1);
            saveAll();
            if (editingItemId === id) {
                editingItemId = null;
            }
            renderSetupItems();
            refreshInventory();
            refreshExpiryTracker();
            updateDashboardStats();
            updateDrugSuggestions();
            alert(`🗑️ "${deletedItem.name}" has been permanently deleted.`);
        }
    }
}

