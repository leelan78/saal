        document.getElementById("lowStockCount").textContent = "0";
        document.getElementById("expiringSoonCount").textContent = "0";
        document.getElementById("expiredCount").textContent = "0";
        document.getElementById("totalUnits").textContent = "0";
        // Clear search results
        document.getElementById('searchResultCount').textContent = '';
        return;
    }
    
    for(let item of inventoryData) {
        totalUnits += item.balance;
        if(item.balance <= 0) outOfStock++;
        else if(item.balance <= item.reorder) lowStock++;
        const expiryInfo = getExpiryStatus(item.expiryDate);
        if(expiryInfo.status === "EXPIRED") expired++;
        if(expiryInfo.status === "Expiring Soon") expiringSoon++;
        
        const row = tbody.insertRow();
        row.insertCell(0).textContent = item.id;
        row.insertCell(1).textContent = item.name;
        row.insertCell(2).textContent = item.location || "";
        row.insertCell(3).textContent = item.unit || "";
        row.insertCell(4).textContent = item.opening;
        row.insertCell(5).textContent = item.received;
        row.insertCell(6).textContent = item.issued;
        row.insertCell(7).innerHTML = `<strong>${item.balance}</strong>`;
        row.insertCell(8).textContent = item.reorder;
        const statusCell = row.insertCell(9);
        const status = computeStockStatus(item.balance, item.reorder);
        if (status === "OUT OF STOCK") {
            statusCell.innerHTML = '<span class="badge badge-outofstock">🚫 OUT OF STOCK</span>';
        } else if (status === "REORDER") {
            statusCell.innerHTML = '<span class="badge badge-reorder">⚠️ REORDER</span>';
        } else {
            statusCell.innerHTML = '<span class="badge badge-ok">✓ OK</span>';
        }
        row.insertCell(10).textContent = item.expiryDate || "Not set";
        const expiryStatusCell = row.insertCell(11);
        expiryStatusCell.innerHTML = `<span class="badge ${expiryInfo.class}">${expiryInfo.status}</span>`;
        if(expiryInfo.status === "EXPIRED") row.classList.add("expired-row");
        else if(expiryInfo.status === "Expiring Soon") row.classList.add("expiring-soon-row");
    }
    
    document.getElementById("totalItems").textContent = inventoryData.length;
    document.getElementById("outOfStockCount").textContent = outOfStock;
    document.getElementById("lowStockCount").textContent = lowStock;
    document.getElementById("expiringSoonCount").textContent = expiringSoon;
    document.getElementById("expiredCount").textContent = expired;
    document.getElementById("totalUnits").textContent = totalUnits.toLocaleString();
    
    // Re-apply search after refresh
    searchInventory();
}

function refreshExpiryTracker() {
    var tbody = document.getElementById("expiryBody");
    if (!tbody) return;
    var filter = document.getElementById("expiryFilter")?.value || "all";
    tbody.innerHTML = "";
    
    if(inventoryData.length === 0) {
        tbody.innerHTML = `<tr><td colspan="8" class="empty-state"><span class="icon">📭</span>No drugs in inventory.</td></tr>`;
        return;
    }
    
    const sortedItems = [...inventoryData].sort((a, b) => {
        if(!a.expiryDate) return 1;
        if(!b.expiryDate) return -1;
        return new Date(a.expiryDate) - new Date(b.expiryDate);
    });
    
    for(let item of sortedItems) {
        const expiryInfo = getExpiryStatus(item.expiryDate);
        if(filter === "expired" && expiryInfo.status !== "EXPIRED") continue;
        if(filter === "expiring-soon" && expiryInfo.status !== "Expiring Soon") continue;
        if(filter === "good" && expiryInfo.status !== "Good") continue;
        if(filter === "no-date" && item.expiryDate) continue;
        
        const row = tbody.insertRow();
        row.insertCell(0).textContent = item.id;
        row.insertCell(1).textContent = item.name;
        row.insertCell(2).textContent = item.location || "";
        row.insertCell(3).innerHTML = `<strong>${item.balance}</strong>`;
        row.insertCell(4).textContent = item.expiryDate || "Not set";
        let daysLeftText = "N/A";
        if (expiryInfo.daysLeft !== null) {
            daysLeftText = expiryInfo.daysLeft < 0
                ? `Expired ${Math.abs(expiryInfo.daysLeft)} day(s) ago`
                : `${expiryInfo.daysLeft} days`;
        }
        row.insertCell(5).textContent = daysLeftText;
        row.insertCell(6).innerHTML = `<span class="badge ${expiryInfo.class}">${expiryInfo.status}</span>`;
        let action = "";
        if(expiryInfo.status === "EXPIRED") action = "⚠️ DISCARD IMMEDIATELY";
        else if(expiryInfo.status === "Expiring Soon") action = "🔔 Use first / Move to front";
        else if(!item.expiryDate) action = "📝 Add expiry date";
        else action = "✓ OK";
        row.insertCell(7).innerHTML = action;
        if(expiryInfo.status === "EXPIRED") row.classList.add("expired-row");
        else if(expiryInfo.status === "Expiring Soon") row.classList.add("expiring-soon-row");
    }
}

