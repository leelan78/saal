function addDrugManually() {
    const name = document.getElementById("manualDrugName").value.trim();
    const location = document.getElementById("manualDrugLocation").value.trim();
    const opening = parseInt(document.getElementById("manualDrugOpening").value) || 0;
    const unit = document.getElementById("manualDrugUnit").value.trim();
    const reorder = parseInt(document.getElementById("manualDrugReorder").value) || 20;
    const expiry = document.getElementById("manualDrugExpiry").value;

    if(!name) {
        alert("Please enter a Drug/Item name!");
        return;
    }

    if(!location) {
        alert("Please enter a Location!");
        return;
    }

    if(inventoryData.some(item => item.name.toLowerCase() === name.toLowerCase())) {
        alert("⚠️ Drug already exists in inventory!");
        return;
    }

    const newDrug = {
        id: generateId(),
        name: name,
        location: location,
        opening: opening,
        received: 0,
        issued: 0,
        balance: opening,
        unit: unit,
        reorder: reorder,
        status: computeStockStatus(opening, reorder),
        expiryDate: expiry
    };

    inventoryData.push(newDrug);
    rememberLocationIfNew(location);
    rememberUnitIfNew(unit);
    saveAll();
    closeAddDrugModal();
    refreshInventory();
    refreshExpiryTracker();
    updateDashboardStats();
    renderSetupItems();
    updateDrugSuggestions();
    alert(`✅ Drug "${name}" added successfully!`);
}

