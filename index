// Sends every queued line item to the admin as its own pending requisition
// in one action.
// Requisitions are read-modify-written through a transaction rather than
// pushed as a whole array from local memory, like the rest of the app's data
// is. Two people acting on requests at nearly the same moment (two admins
// approving different requests, or two staff submitting at once) used to be
// able to silently overwrite each other's change - whoever's local copy was
// pushed last would win, sometimes making a just-approved request look
// "pending" again. A transaction always reads the freshest copy from
// Firestore right before writing, so both changes land instead of one
// clobbering the other.
function mutateSharedRequisitions(mutatorFn) {
    return db.runTransaction(function(transaction) {
        return transaction.get(sharedDocRef).then(function(doc) {
            const current = doc.exists ? (doc.data().requisitions || []) : [];
            const updated = mutatorFn(current.slice());
            transaction.update(sharedDocRef, {
                requisitions: updated,
                updatedAt: firebase.firestore.FieldValue.serverTimestamp()
            });
            return updated;
        });
    });
}

function submitAllRequisitions() {
    if (pendingRequisitions.length === 0) {
        alert("Your list is empty — add at least one drug first.");
        return;
    }

    const toSubmit = pendingRequisitions.map(p => ({
        id: generateRequisitionId(),
        date: p.date,
        drug: p.drug,
        location: p.location,
        qtyRequested: p.qty,
        qtyApproved: null,
        unit: p.unit,
        notes: p.notes,
        requestedBy: currentUserEmail,
        requestedAt: new Date().toISOString(),
        status: "pending",
        reviewedBy: "",
        reviewedAt: ""
    }));
    const count = toSubmit.length;

    mutateSharedRequisitions(arr => arr.concat(toSubmit)).then(updatedArr => {
        requisitions = updatedArr;
        pendingRequisitions = [];
        renderRequisitions();
        renderPendingRequisitions();
        alert(`✅ ${count} request${count === 1 ? "" : "s"} submitted! An admin will review ${count === 1 ? "it" : "them"}.`);
    }).catch(e => {
        alert("❌ Could not submit your request(s), please try again: " + e.message);
    });
}

