let pendingRequisitions = [];

// Looks up the drug currently typed in the Request form and, if it exists in
// inventory, shows the quantity currently available so staff can see stock
// levels before deciding how much to request.
function updateReqAvailability() {
    const drugName = document.getElementById("reqDrug").value.trim();
    const hint = document.getElementById("reqAvailableQty");
    const qtyField = document.getElementById("reqQty");
    if (!hint) return;
    const enteredQty = parseInt(qtyField.value) || 0;

    if (!drugName) {
        hint.textContent = "";
        hint.className = "field-hint";
        return;
    }

    const item = inventoryData.find(i => i.name.toLowerCase() === drugName.toLowerCase());
    if (item) {
        if (enteredQty > item.balance) {
            hint.textContent = `⚠️ Only ${item.balance} ${item.unit || ""} available at ${item.location || "no location set"}`;
            hint.className = "field-hint warning";
        } else {
            hint.textContent = `📦 Available: ${item.balance} ${item.unit || ""} at ${item.location || "no location set"}`;
            hint.className = "field-hint";
        }
    } else {
        hint.textContent = "⚠️ Not currently in inventory";
        hint.className = "field-hint warning";
    }
}

// Adds the current form values as a queued line item — lets staff build up a
// list of several drugs before sending the whole batch to the admin at once.
function addRequisitionToPending() {
    const date = document.getElementById("reqDate").value;
    const drug = document.getElementById("reqDrug").value.trim();
    const location = document.getElementById("reqLocation").value.trim();
    const qty = parseInt(document.getElementById("reqQty").value) || 0;
    const unit = document.getElementById("reqUnit").value.trim();
    const notes = document.getElementById("reqNotes").value.trim();

    if (!date || !drug || qty <= 0) {
        alert("Please fill Date, Drug/Item, and a valid Quantity!");
        return;
    }

    const stockItem = inventoryData.find(i => i.name.toLowerCase() === drug.toLowerCase());
    const resolvedLocation = location || (stockItem ? stockItem.location : "");
    const resolvedUnit = unit || (stockItem ? stockItem.unit : "");

    pendingRequisitions.push({
        pendingId: Date.now() + Math.random(),
        date: date,
        drug: drug,
        location: resolvedLocation,
        qty: qty,
        unit: resolvedUnit,
        notes: notes
