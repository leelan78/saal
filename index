function updateIssueAvailability() {
    const drugName = document.getElementById("issueDrug").value.trim();
    const hint = document.getElementById("issueAvailableQty");
    const locationField = document.getElementById("issueLocation");
    const unitField = document.getElementById("issueUnit");
    const qtyField = document.getElementById("issueQty");
    const enteredQty = parseInt(qtyField.value) || 0;

    if (!drugName) {
        hint.textContent = "";
        hint.className = "field-hint";
        qtyField.removeAttribute("max");
        return;
    }

    const item = inventoryData.find(i => i.name.toLowerCase() === drugName.toLowerCase());

    if (item) {
        locationField.value = item.location || "";
        if (item.unit && !unitField.value) unitField.value = item.unit;
        qtyField.max = item.balance;

        if (enteredQty > item.balance) {
            hint.textContent = `⚠️ Only ${item.balance} ${item.unit || ""} available — this exceeds available stock!`;
            hint.className = "field-hint warning";
        } else {
            hint.textContent = `📦 Available: ${item.balance} ${item.unit || ""} at ${item.location || "no location set"}`;
            hint.className = "field-hint";
        }
    } else {
        hint.textContent = "⚠️ New/unknown drug — no stock on record yet";
        hint.className = "field-hint warning";
        qtyField.removeAttribute("max");
    }
}

