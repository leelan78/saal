function searchInventory() {
    const input = document.getElementById('inventorySearch');
    const searchTerm = input ? input.value.trim().toLowerCase() : '';
    const tbody = document.getElementById('inventoryBody');
    
    if (!tbody) return;
    
    const rows = tbody.getElementsByTagName('tr');
    let visibleCount = 0;
    let totalRows = 0;
    
    // If search is empty, show all rows
    if (!searchTerm) {
        for (let row of rows) {
            if (!row.classList.contains('empty-state')) {
                row.style.display = '';
                totalRows++;
            }
        }
        document.getElementById('searchResultCount').textContent = '';
        return;
    }
    
    // Loop through rows and filter
    for (let row of rows) {
        // Skip the empty state row
        if (row.classList.contains('empty-state')) {
            row.style.display = '';
            continue;
        }
        
        const cells = row.getElementsByTagName('td');
        if (cells.length === 0) continue;
        
        totalRows++;
        let match = false;
        // Check each cell (name, location, ID)
        for (let i = 0; i < Math.min(cells.length, 3); i++) {
            const text = cells[i].textContent.toLowerCase();
            if (text.includes(searchTerm)) {
                match = true;
                break;
            }
        }
        
        if (match) {
            row.style.display = '';
            visibleCount++;
        } else {
            row.style.display = 'none';
        }
    }
    
    // Update result count
    const emptyState = tbody.querySelector('.empty-state');
    if (emptyState && emptyState.style.display !== 'none') {
        document.getElementById('searchResultCount').textContent = '';
        return;
    }
    
    document.getElementById('searchResultCount').textContent = 
        visibleCount > 0 ? `Showing ${visibleCount} of ${totalRows} drugs` : 'No matching drugs found';
}

