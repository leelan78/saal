function refreshInventory() {
    var tbody = document.getElementById("inventoryBody");
    if (!tbody) return;
    tbody.innerHTML = "";
    let totalUnits = 0, outOfStock = 0, lowStock = 0, expiringSoon = 0, expired = 0;
    
    if(inventoryData.length === 0) {
        tbody.innerHTML = `<tr><td colspan="12" class="empty-state"><span class="icon">📭</span>No drugs in inventory. Add your first drug!</td></tr>`;
        document.getElementById("totalItems").textContent = "0";
